package MultiboardAttach
import FramehandleNames
import ClosureTimers
import TableLayout

/*
    Attach custom content to the existing multiboard UI (reuse maximize/minimize behavior).
    The native multiboard backdrop remains the single panel background.

    MULTIPLAYER - THIS PACKAGE IS NOT PER-PLAYER. Unlike the rest of the library it does not deal in
    frames alone: multiboard row count and item style (MultiboardSetRowCount / MultiboardSetItemsStyle)
    are SYNCHRONIZED game state, and the refresh ticker is a timer handle created on first attach.
    Every attach/refresh function here must therefore run identically on every client. Never call one
    inside a localPlayer block, and never make an attach conditional on client-local state.

    To show a board to only some players, attach it for everyone and scope the native multiboard's own
    visibility per player (multiboard display is player-scoped by the engine), or build a map-owned
    panel with panelTable() and perPlayerFrames() instead.

    Non-TableLayout callers must provide an accurate content height. Table layouts should use
    attachTableLayoutToMultiboard(), which measures their rows and padding.

    Minimal hello-world test using TableLayout (with multiboard-style backdrop):
    
    let mb = CreateMultiboard()
    ..setRowCount(1)
    ..setColumnCount(1)
    ..show()
    ..setTitle("Demo Board")

    attachTableLayoutToMultiboard(mb, "DemoMb", true,
        uiParent -> begin
            let layout = new TableLayout(0.22, 0., "DemoMbLayout")
            layout.padding = padding(SPACE_XS + SPACE_2XS, SPACE_S + SPACE_XS, SPACE_XS + SPACE_2XS, SPACE_S + SPACE_XS)
            layout
            ..row()
            ..add(p("Hello world")..setSize(0.18, 0.014))
            return layout
        end
    )
*/

public var autoRowsEnabled = true
public var rowHeightEstimate = 0.0125

constant ATTACH_REFRESH_PERIOD = 0.03

framehandle attachedItemContainer = null
framehandle attachedNativeBackdrop = null
framehandle attachedTitleBackdrop = null
multiboard attachedBoard = null
TableLayout attachedLayout = null
real attachedPanelWidth = 0.
real attachedTitleWidth = 0.
real attachedContentHeight = 0.
CallbackPeriodic attachedRefreshTicker = null

// The periodic reassert re-anchors the container only when this cache says its geometry changed.
// attachToMultiboardSized(), refreshAttachedMultiboardLayout() and an explicit refreshAttachedMultiboard()
// all invalidate it, so the next pass after any of them always writes.
let attachedContainerCache = new AttachedContainerCache()

function rowsNeededFor(real contentHeight) returns int
    let target = contentHeight
    return max(1, (target / rowHeightEstimate).ceil())

public interface MultiboardContentBuilder
    function build(framehandle uiParent, framehandle anchor) returns framehandle

public interface MultiboardLayoutBuilder
    function build(framehandle uiParent) returns TableLayout

public function fitMultiboardRowsToHeight(multiboard board, real contentHeight)
    board.setRowCount(rowsNeededFor(contentHeight))

/**
    The container geometry an attachment last wrote. needsWrite() returns true, and records the new
    geometry as written, when the container, its anchor or its size differ from the last write or the
    cache was invalidated. MultiboardAttach feeds it only the synced attachment globals (never a frame
    getter or the client's screen size), so its answer is the same on every client.
*/
public class AttachedContainerCache
    private var valid = false
    private framehandle container = null
    private framehandle anchor = null
    private var width = 0.
    private var height = 0.

    function invalidate()
        valid = false

    function needsWrite(framehandle container, framehandle anchor, real width, real height) returns boolean
        if valid and this.container == container and this.anchor == anchor and this.width == width and this.height == height
            return false
        valid = true
        this.container = container
        this.anchor = anchor
        this.width = width
        this.height = height
        return true

/**
    Reassert the geometry owned by the active attachment, writing the container only when it changed.
    This is what the refresh ticker runs every ATTACH_REFRESH_PERIOD.

    Warcraft III rewrites the shared multiboard frames after minimize/maximize, timer-dialog changes,
    and some show calls, with no event for it, so the two native shell sizes are written on every pass.
    Keep the native body at the measured layout size: its synthetic native rows are bookkeeping and use
    a different height from TableLayout rows. The custom container is ours; the engine never rewrites it
    and its TOPRIGHT anchor follows the native backdrop on its own, so it is re-anchored only when the
    wanted geometry differs from what was last written.
*/
function reassertAttachedMultiboard()
    if attachedItemContainer == null or attachedNativeBackdrop == null
        return

    if attachedTitleBackdrop != null and attachedTitleWidth > 0.
        attachedTitleBackdrop.setWidth(attachedTitleWidth)

    // Preserve Blizzard's native horizontal anchors: TOPLEFT is attached to the title and TOPRIGHT
    // to the minimize button, so they already span the complete visible header. Only height is ours.
    attachedNativeBackdrop.setHeight(attachedContentHeight)

    if attachedContainerCache.needsWrite(attachedItemContainer, attachedNativeBackdrop, attachedPanelWidth, attachedContentHeight)
        attachedItemContainer
        ..clearAllPoints()
        ..setSize(attachedPanelWidth, attachedContentHeight)
        ..setPoint(FRAMEPOINT_TOPRIGHT, attachedNativeBackdrop, FRAMEPOINT_TOPRIGHT, vec2(0, 0))

/**
    Rewrite all geometry owned by the active multiboard attachment, unconditionally.

    Call this after changing the returned item container yourself or after anything else that may have
    moved it; the periodic reassert skips the container while its own wanted geometry is unchanged.
*/
public function refreshAttachedMultiboard()
    attachedContainerCache.invalidate()
    reassertAttachedMultiboard()

/**
    Re-measure and apply the active TableLayout attachment after rows are added or removed.
*/
public function refreshAttachedMultiboardLayout()
    if attachedLayout == null or attachedItemContainer == null
        refreshAttachedMultiboard()
        return

    attachedPanelWidth = max(attachedLayout.width, 0.001)
    attachedContentHeight = max(attachedLayout.fitHeightToContent(), rowHeightEstimate)
    if autoRowsEnabled and attachedBoard != null
        fitMultiboardRowsToHeight(attachedBoard, attachedContentHeight)
    attachedLayout.applyTo(attachedItemContainer)
    refreshAttachedMultiboard()

function ensureAttachedMultiboardRefreshTicker()
    if attachedRefreshTicker == null
        // The default UI has no event for every geometry rewrite. A few cheap frame updates per tick
        // are more reliable than guessing which native show/timer-dialog transition needs a delay.
        attachedRefreshTicker = doPeriodically(ATTACH_REFRESH_PERIOD) cb ->
            reassertAttachedMultiboard()

public function attachToMultiboardSized(
    multiboard board,
    string baseName,
    real panelWidth,
    real titleBackdropWidth,
    real contentHeight,
    boolean hideDefaultMultiboardItems,
    MultiboardContentBuilder builder
) returns framehandle

    let titleBackdrop = getFrame(FramehandleDefaultNames.multiboardTitleBackdrop)
    let backdrop      = getFrame(FramehandleDefaultNames.multiboardBackdrop)
    let listContainer = getFrame(FramehandleDefaultNames.multiboardListContainer)

    if hideDefaultMultiboardItems
        MultiboardSetItemsStyle(board, false, false)

    if autoRowsEnabled
        fitMultiboardRowsToHeight(board, contentHeight)

    // All multiboards reuse the same Blizzard shell. Retire an older custom attachment instead of
    // leaving its container/backdrop stacked under the new one.
    if attachedItemContainer != null
        attachedItemContainer.hide()
    let itemContainer = createFrame("FRAME", baseName + "_ItemContainer", listContainer, "", 0)
    itemContainer.setLevel(1)

    attachedItemContainer = itemContainer
    attachedNativeBackdrop = backdrop
    attachedTitleBackdrop = titleBackdrop
    attachedBoard = board
    attachedLayout = null
    attachedPanelWidth = max(panelWidth, 0.001)
    attachedTitleWidth = titleBackdropWidth
    attachedContentHeight = max(contentHeight, rowHeightEstimate)

    refreshAttachedMultiboard()

    if builder != null
        builder.build(listContainer, itemContainer)

    // Reassert after the builder sizes its layout, and keep doing so after native UI refreshes.
    refreshAttachedMultiboard()
    ensureAttachedMultiboardRefreshTicker()

    return itemContainer

/**
    Build, measure, and attach a TableLayout to the native multiboard shell.

    The layout width owns the title and content width. Blizzard's native backdrop anchors already span
    the title plus minimize button, while declared rows are the height authority. Callers do not need
    to duplicate geometry arithmetic or run their own refresh timer. Call
    refreshAttachedMultiboardLayout() after dynamically adding or removing rows.
*/
public function attachTableLayoutToMultiboard(
    multiboard board,
    string baseName,
    boolean hideDefaultMultiboardItems,
    MultiboardLayoutBuilder builder
) returns framehandle
    if builder == null
        return null

    // Establish the final container first, then build the table under it from birth. This avoids the
    // dual-parent behavior caused by creating cells under GAME_UI/listContainer and reparenting later.
    let itemContainer = attachToMultiboardSized(
        board,
        baseName,
        0.001,
        0.001,
        rowHeightEstimate,
        hideDefaultMultiboardItems,
        null
    )
    if itemContainer == null
        return null

    let previousParent = defaultFrameParent
    defaultFrameParent = itemContainer
    let layout = builder.build(itemContainer)
    defaultFrameParent = previousParent
    if layout == null
        return itemContainer

    attachedLayout = layout
    attachedTitleWidth = layout.width
    refreshAttachedMultiboardLayout()
    return itemContainer

/**
    Attach custom content inside the native multiboard backdrop.
*/
public function attachToMultiboard(
    multiboard board,
    string baseName,
    real titleBackdropWidth,
    real contentHeight,
    boolean hideDefaultMultiboardItems,
    MultiboardContentBuilder builder
) returns framehandle
    return attachToMultiboardSized(board, baseName, titleBackdropWidth, titleBackdropWidth,
        contentHeight, hideDefaultMultiboardItems, builder)

