package MultiboardAttach
import FramehandleNames
import ClosureTimers

/*
    Attach custom content to the existing multiboard UI (reuse maximize/minimize behavior),
    and recreate the usual multiboard "panel" backdrop behind your content.

    /!\ You must set your multiboard to have an appropriate amount of rows to fit your content height. /!\ 

    Minimal hello-world test using TableLayout (with multiboard-style backdrop):
    
    let mb = CreateMultiboard()
    ..setRowCount(1)
    ..setColumnCount(1)
    ..show()
    ..setTitle("Demo Board")

    attachToMultiboard(mb, "DemoMb", 0.22, 0.08, true,
        (uiParent, anchor) -> begin
            let layout = new TableLayout(0.22, 0.1, "DemoMbLayout")
            layout.padding = padding(0.006, 0.012, 0.006, 0.012)
            layout
            ..row()
            ..add(p("Hello world"))
            layout.applyTo(anchor)
            return anchor
        end
    )
*/

public var autoRowsEnabled = true
public var rowHeightEstimate = 0.0125

constant ATTACH_REFRESH_PERIOD = 0.03

framehandle attachedItemContainer = null
framehandle attachedPanelBackdrop = null
framehandle attachedNativeBackdrop = null
framehandle attachedTitleBackdrop = null
real attachedPanelWidth = 0.
real attachedTitleWidth = 0.
real attachedContentHeight = 0.
CallbackPeriodic attachedRefreshTicker = null

function rowsNeededFor(real contentHeight) returns int
    let target = contentHeight
    return max(1, (target / rowHeightEstimate).ceil())

public interface MultiboardContentBuilder
    function build(framehandle uiParent, framehandle anchor) returns framehandle

public function fitMultiboardRowsToHeight(multiboard board, real contentHeight)
    board.setRowCount(rowsNeededFor(contentHeight))

/**
    Reassert the geometry owned by the active multiboard attachment.

    Warcraft III rewrites the shared multiboard frames after minimize/maximize, timer-dialog changes,
    and some show calls. Keeping this visual-only geometry authoritative prevents the custom content
    from being squeezed back to the native item width.
*/
public function refreshAttachedMultiboard()
    if attachedItemContainer == null or attachedNativeBackdrop == null
        return

    attachedNativeBackdrop.hide()
    if attachedTitleBackdrop != null and attachedTitleWidth > 0.
        attachedTitleBackdrop.setWidth(attachedTitleWidth)

    attachedItemContainer
    ..clearAllPoints()
    ..setSize(attachedPanelWidth, attachedContentHeight)
    ..setPoint(FRAMEPOINT_TOPRIGHT, attachedNativeBackdrop, FRAMEPOINT_TOPRIGHT, vec2(0, 0))

    if attachedPanelBackdrop != null
        attachedPanelBackdrop.show()

function ensureAttachedMultiboardRefreshTicker()
    if attachedRefreshTicker == null
        // The default UI has no event for every geometry rewrite. A few cheap frame updates per tick
        // are more reliable than guessing which native show/timer-dialog transition needs a delay.
        attachedRefreshTicker = doPeriodically(ATTACH_REFRESH_PERIOD) cb ->
            refreshAttachedMultiboard()

public function attachToMultiboardSized(
    multiboard board,
    string baseName,
    real panelWidth,
    real titleBackdropWidth,
    real contentHeight,
    boolean hideDefaultMultiboardItems,
    MultiboardContentBuilder builder
) returns framehandle

    let titleBackdrop = getFrame(FramehandleDefaultNames.multiboardTitleBackdrop)
    let backdrop      = getFrame(FramehandleDefaultNames.multiboardBackdrop)
    let listContainer = getFrame(FramehandleDefaultNames.multiboardListContainer)

    if hideDefaultMultiboardItems
        MultiboardSetItemsStyle(board, false, false)

    if autoRowsEnabled
        fitMultiboardRowsToHeight(board, contentHeight)

    // All multiboards reuse the same Blizzard shell. Retire an older custom attachment instead of
    // leaving its container/backdrop stacked under the new one.
    if attachedItemContainer != null
        attachedItemContainer.hide()
    if attachedPanelBackdrop != null
        attachedPanelBackdrop.hide()

    let itemContainer = createFrame("FRAME", baseName + "_ItemContainer", listContainer, "", 0)
    itemContainer.setLevel(1)

    let panelBackdrop = createFrame("TableUiMultiboardBackdrop", listContainer, 0, 1)
    if panelBackdrop != null
        panelBackdrop..setLevel(0)..disable()

    attachedItemContainer = itemContainer
    attachedPanelBackdrop = panelBackdrop
    attachedNativeBackdrop = backdrop
    attachedTitleBackdrop = titleBackdrop
    attachedPanelWidth = max(panelWidth, 0.001)
    attachedTitleWidth = titleBackdropWidth
    attachedContentHeight = max(contentHeight, rowHeightEstimate)

    if panelBackdrop != null
        panelBackdrop.setAllPoints(itemContainer)

    refreshAttachedMultiboard()

    if builder != null
        builder.build(listContainer, itemContainer)

    // Reassert after the builder sizes its layout, and keep doing so after native UI refreshes.
    refreshAttachedMultiboard()
    ensureAttachedMultiboardRefreshTicker()

    return itemContainer

/**
    Attach custom content to a multiboard, recreating the usual multiboard backdrop.
*/
public function attachToMultiboard(
    multiboard board,
    string baseName,
    real titleBackdropWidth,
    real contentHeight,
    boolean hideDefaultMultiboardItems,
    MultiboardContentBuilder builder
) returns framehandle
    return attachToMultiboardSized(board, baseName, titleBackdropWidth, titleBackdropWidth,
        contentHeight, hideDefaultMultiboardItems, builder)

