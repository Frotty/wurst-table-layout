package TableUiModal
// Full-screen modal barrier placed in a z-band layer below its paired dialog or dropdown.
//
// Opaque mode (dialogs): dims the whole physical screen — a dark translucent backdrop in the 4:3
// band plus ConsoleUIBackdrop-parented strips for the widescreen margins — so the dialog stands
// out against the background, and blocks all clicks on content beneath. Wire up via the
// withModal() method on UIConfirmDialog / UIDialog — no manual construction needed there.
//
// Transparent mode (selects): invisible but still blocks all clicks outside the dropdown so
// clicking anywhere outside it closes the menu. UISelect creates its own barrier automatically.
import TableLayout
import TableUiLayers

// Level constants for siblings within the DIALOG band.
// The barrier sits below its paired dialog frame; raise the dialog to MODAL_CONTENT_LEVEL.
public constant MODAL_BARRIER_LEVEL = 1
public constant MODAL_CONTENT_LEVEL = 2

// Default dim opacity for dialog backdrops (80% black).
public constant MODAL_DEFAULT_OPACITY = 0.8

// Full WC3 4:3 viewport in UI coordinate space.
constant SCREEN_W = 0.8
constant SCREEN_H = 0.6

// The dim covers the 4:3 band with a BACKDROP child of the barrier (in the DIALOG band, so other
// Frame UI beneath the dialog is dimmed too — the dialog is translucent and must not mix with
// undimmed content), plus two strips flanking the band for the widescreen margins. The strips are
// parented to ConsoleUIBackdrop, the sanctioned escape hatch whose Frame-group children may leave
// the 4:3 band without malforming (WC3_FRAMEHANDLE_GUIDE.md "Safe Areas"). They render below
// SimpleFrames — fine for the margins, where only the game world is visible. Screen height is
// always 0.6 in UI coordinates; only width grows with aspect ratio (~1.07 at 16:9, 1.4 at 21:9),
// so 0.4 per side covers everything up to 24:9.
constant DIM_STRIP_W = 0.4

// Stdlib getFrame(name, context) is shadowed inside UIModalBackdrop by its own getFrame() method,
// so the ConsoleUIBackdrop lookup goes through this free function.
function namedChild(string name, int context) returns framehandle
    return getFrame(name, context)

/** `p` is the player who clicked the barrier. */
public interface ModalDismissCallback
    function run(player p)

/** Full-screen modal barrier: a click-catcher placed one level below its paired dialog or
    dropdown within a shared z-band.

    - opacity > 0 (dialogs): creates a dark translucent BACKDROP child covering the 4:3 band
      (in the DIALOG band, so other Frame UI beneath the dialog is dimmed too) plus two
      ConsoleUIBackdrop-parented strips covering the widescreen margins, so the entire physical
      screen looks dimmed. Clicking the barrier fires the dismiss callback.
    - opacity = 0 (selects): no dim; the barrier is transparent but still catches
      outside clicks, closing the dropdown automatically.

    Create once; call show()/hide() in sync with the paired dialog/menu. */
public class UIModalBackdrop
    private framehandle barrier = null
    private framehandle dimLeft = null
    private framehandle dimRight = null
    private Layer layer
    private int level
    private int dimAlpha

    construct(Layer layer, int level, real opacity)
        this.layer = layer
        this.level = level
        this.dimAlpha = R2I(opacity * 255.)

    /** Creates (once) the barrier frame and optional dark backdrop child. */
    function create() returns framehandle
        if barrier != null
            return barrier
        barrier = createFrame("TableUiModalBarrier", layer.getFrame(), 0, nextUiContext())
            ..setAbsPoint(FRAMEPOINT_CENTER, vec2(0.4, 0.3))
            ..setSize(SCREEN_W, SCREEN_H)
            ..setLevel(level)
            ..hide()
        if dimAlpha > 0
            // Disabled so only the parent GLUEBUTTON intercepts mouse input.
            createFrame("TableUiModalBarrierBackdrop", barrier, 0, nextUiContext())
                ..setAllPoints(barrier)
                ..setAlpha(dimAlpha)
                ..disable()
            // Strips flanking the 4:3 band so the widescreen margins look dimmed too.
            dimLeft = createDimStrip(FRAMEPOINT_RIGHT, vec2(0., 0.3))
            dimRight = createDimStrip(FRAMEPOINT_LEFT, vec2(SCREEN_W, 0.3))
        return barrier

    private function createDimStrip(framepointtype anchor, vec2 pos) returns framehandle
        // Disabled: decorative dim only — Frame-group hit areas outside the 4:3 band are unreliable,
        // and the paired barrier already catches the dismiss clicks.
        return createFrame("TableUiModalBarrierBackdrop", namedChild("ConsoleUIBackdrop", 0), 0, nextUiContext())
            ..setAbsPoint(anchor, pos)
            ..setSize(DIM_STRIP_W, SCREEN_H)
            ..setAlpha(dimAlpha)
            ..disable()
            ..hide()

    function getFrame() returns framehandle
        return create()

    function show() returns thistype
        create().show()
        if dimLeft != null
            dimLeft.show()
            dimRight.show()
        return this

    function hide() returns thistype
        if barrier != null
            barrier.hide()
        if dimLeft != null
            dimLeft.hide()
            dimRight.hide()
        return this

    /** Shows or hides the barrier (and the widescreen dim strips) FOR ONE PLAYER. Creates the frames
        on every client first, then flips only that player's visibility flag - the safe shape.
        Never wrap this in a localPlayer block. */
    function setVisible(player p, bool flag) returns thistype
        create().setVisible(p, flag)
        if dimLeft != null
            dimLeft.setVisible(p, flag)
            dimRight.setVisible(p, flag)
        return this

    function show(player p) returns thistype
        return setVisible(p, true)

    function hide(player p) returns thistype
        return setVisible(p, false)

    /** Registers the callback fired when the barrier is clicked (outside the dialog/menu). */
    function onClick(ModalDismissCallback cb) returns thistype
        create()
        barrier.onClick() ->
            barrier.releaseKeyboardFocus(GetTriggerPlayer())
            cb.run(GetTriggerPlayer())
        return this
