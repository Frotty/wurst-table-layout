package TableUiSliders
// A labelled value slider on WC3's native SLIDER: [label] [====O====] [value].
import TableLayout
import TableUiText
import ClosureTimers

/** `p` is the player whose drag produced the value, or null when the change came from setValue(). */
public interface SliderListener
    function onChange(player p, real value)

/** A labelled value slider on WC3's native SLIDER: [label] [====O====] [value]. Set the range in the
    constructor, tune step/decimals, read getValue(), and react with onChange(); the value text and
    knob update automatically. */
public class UISlider
    private real minValue = 0.
    private real maxValue = 100.
    private real stepSize = 1.
    private real value = 0.
    private int valueDecimals = 0
    private real width = 0.
    private string label = ""
    private real height = 0.024
    private boolean showValue = true
    private SliderListener listener = null
    private boolean syncingValue = false
    private CallbackSingle pendingKnobSync = null
    private framehandle root = null
    private framehandle sliderFrame = null
    private framehandle valueFrame = null
    private FrameHandleListener valueChangeFrameListener = null

    construct(string label, real width, real minValue, real maxValue)
        this.label = label
        this.width = width
        this.minValue = minValue
        this.maxValue = maxValue
        this.value = minValue

    /** Input-only slider for scrollbars: no caption or value column. */
    construct(real width, real height, real minValue, real maxValue)
        this.width = width
        this.height = height
        this.minValue = minValue
        this.maxValue = maxValue
        this.value = minValue
        showValue = false

    private function format(real v) returns string
        return v.toString(valueDecimals)

    /** Decimal places shown in the value label (default 0). */
    function setDecimals(int decimals) returns thistype
        valueDecimals = decimals
        if valueFrame != null
            valueFrame.setText(format(value))
        return this

    function setStep(real newStep) returns thistype
        stepSize = newStep
        if sliderFrame != null
            sliderFrame.setStepSize(newStep)
        return this

    function setValue(real newValue) returns thistype
        let nextValue = max(minValue, min(maxValue, newValue))
        if nextValue == value
            return this
        value = nextValue
        if sliderFrame != null
            syncingValue = true
            sliderFrame.setValue(value)
            syncingValue = false
        if valueFrame != null
            valueFrame.setText(format(value))
        return this

    /** Updates the range only when it changes and clamps the model value to it. */
    function setRange(real minValue, real maxValue) returns thistype
        if this.minValue == minValue and this.maxValue == maxValue
            return this
        this.minValue = minValue
        this.maxValue = maxValue
        if sliderFrame != null
            syncingValue = true
            sliderFrame.setMinMax(minValue, maxValue)
            syncingValue = false
        return setValue(value)

    // Frame input is synchronized, but a drag moves the native knob only on its originating client.
    // Coalesce queued payloads before mirroring the latest model value on every client. The event
    // produced by this write has the same value and therefore cannot schedule another write.
    private function scheduleKnobSync()
        if pendingKnobSync != null
            return
        pendingKnobSync = doAfter(0.) ->
            pendingKnobSync = null
            sliderFrame.setValue(value)

    function onChange(SliderListener cb) returns thistype
        listener = cb
        return this

    function getValue() returns real
        return value

    function create() returns framehandle
        if root != null
            return root
        let prevParent = defaultFrameParent
        root = layoutFrame(defaultFrameParent)..setSize(width, height)
        defaultFrameParent = root

        sliderFrame = createFrame("TableUiSlider", root, 0, nextUiContext())
        sliderFrame..setMinMax(minValue, maxValue)..setStepSize(stepSize)..setValue(value)

        // Floor the value column so multi-digit / decimal values (e.g. "100.0") do not wrap to a
        // second line on a narrow slider.
        if showValue
            valueFrame = p(format(value))
                ..setSize(max(0.034, width * 0.18), height)
                ..setTextAlignment(TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_RIGHT)

        valueChangeFrameListener = sliderFrame.onSliderValueChange() ->
            // Never write the knob from this event: a burst can replay old payloads indefinitely.
            // Clamp against today's range because the payload may predate setRange().
            let programmatic = syncingValue
            let nextValue = max(minValue, min(maxValue, BlzGetTriggerFrameValue()))
            let changed = nextValue != value
            value = nextValue
            if changed
                scheduleKnobSync()
            if valueFrame != null
                valueFrame.setText(format(value))
            if changed and not programmatic
                if listener != null
                    listener.onChange(GetTriggerPlayer(), value)

        if showValue
            let layout = new TableLayout(width, height, "Slider")
            layout.padding = padding(0, 0, 0, 0)
            layout.gap(SPACE_XS + SPACE_2XS, 0)
            layout..row()..middle()
            if label != ""
                layout..add(p(label)..setSize(width * 0.30, height)..setTextAlignment(TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_LEFT))
            layout..add(sliderFrame)..growX()
            layout..add(valueFrame)
            layout.applyTo(root)
            destroy layout
        else
            sliderFrame.setAllPoints(root)
        defaultFrameParent = prevParent
        return root

    ondestroy
        if pendingKnobSync != null
            destroy pendingKnobSync
            pendingKnobSync = null
        if root != null
            root.hide()
        if valueChangeFrameListener != null
            destroy valueChangeFrameListener
            valueChangeFrameListener = null

    function getFrame() returns framehandle
        return create()

    /** Shows or hides the slider FOR ONE PLAYER. Allocates for every client first, then flips only
        that player's visibility flag - the safe shape. Never wrap this in a localPlayer block. */
    function setVisible(player p, bool flag) returns thistype
        create().setVisibleForOwner(p, flag)
        return this

    function show(player p) returns thistype
        return setVisible(p, true)

    function hide(player p) returns thistype
        return setVisible(p, false)

public function slider(string label, real width, real minValue, real maxValue) returns UISlider
    return new UISlider(label, width, minValue, maxValue)

public function slider(real width, real minValue, real maxValue) returns UISlider
    return new UISlider("", width, minValue, maxValue)

/** Input-only slider with an explicit height; suitable for navigation/scrollbars. */
public function slider(real width, real height, real minValue, real maxValue) returns UISlider
    return new UISlider(width, height, minValue, maxValue)
