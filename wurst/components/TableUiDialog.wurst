package TableUiDialog
// Code-driven dialogs on the DIALOG layer (above ordinary UI): a yes/no confirm prompt
// (confirmDialog / UIConfirmDialog) and a blank dialog frame with map-side content (dialogFrame /
// UIDialog). Content is built in place under the dialog frame to avoid hit-area misalignment.
//
// Both support .withModal() to attach a dark full-screen backdrop that dims the scene while the
// dialog is shown and closes it on any outside click.
import TableLayout
import TableUiText
import TableUiButtons
import TableUiPanels
import TableUiLayers
import TableUiSafeArea
import TableUiModal

public interface ConfirmDialogListener
    function onAccept(player p)
    function onCancel(player p)

public class UIConfirmDialog
    string title = ""
    string message = ""
    string acceptText = "Yes"
    string cancelText = "No"
    real width = 0.24
    real height = 0.13
    framehandle frame = null
    ConfirmDialogListener listener = null
    UIModalBackdrop modal = null
    // Set once the dialog has been shown/hidden per player. Dismissal then follows the same scope:
    // a shared dialog closes for everyone (one decision, made once), a per-player prompt closes only
    // for whoever answered it. Without this, one player clicking the dim closed the prompt for all.
    private var ownerScoped = false

    construct(string title, string message)
        this.title = title
        this.message = message

    construct(string title, string message, real width, real height)
        this.title = title
        this.message = message
        this.width = width
        this.height = height

    function setButtons(string acceptText, string cancelText) returns thistype
        this.acceptText = acceptText
        this.cancelText = cancelText
        return this

    function onResult(ConfirmDialogListener listener) returns thistype
        this.listener = listener
        return this

    /** Attaches a dark full-screen backdrop that dims the scene behind the dialog and closes it
        (firing onCancel) on any outside click. Call before show(). Default opacity: 0.8.
        The outside click closes the dialog for the CLICKING player when it was shown per player
        (show(p)), or for everyone when it was shown globally (show()). */
    function withModal() returns thistype
        return withModal(MODAL_DEFAULT_OPACITY)

    function withModal(real opacity) returns thistype
        if modal == null
            modal = new UIModalBackdrop(Layer.DIALOG, MODAL_BARRIER_LEVEL, opacity)
            modal.onClick() clicker ->
                dismissFor(clicker)
                if listener != null
                    listener.onCancel(clicker)
        return this

    /** Closes the dialog for `p` alone when it was shown per player, or for everyone when it was
        shown globally. Answering a prompt only you can see must not close it for the others. */
    private function dismissFor(player p)
        if ownerScoped and p != null
            hide(p)
        else
            hide()

    function create() returns framehandle
        if frame != null
            return frame

        let prevParent = defaultFrameParent
        // The dialog lives in the DIALOG layer (a GAME_UI child held above ordinary content) so it
        // renders on top of panels without reparenting. Dropdowns sit one layer higher (OVERLAY).
        defaultFrameParent = Layer.DIALOG.getFrame()

        // Modal barrier: created first so it shares the DIALOG layer as a sibling below the panel.
        if modal != null
            modal.create()

        frame = panel(width, height)
            ..hide()

        // Raise above the modal barrier when active so the panel receives input first.
        if modal != null
            frame.setLevel(MODAL_CONTENT_LEVEL)

        // Create the buttons + text UNDER the dialog frame so TableLayout's setParent is a no-op.
        // A reparented frame stays in both parents' child lists in WC3, which can misalign its clickable area.
        defaultFrameParent = frame

        let accept = textButton(acceptText, 0.07, 0.024)
        let cancel = textButton(cancelText, 0.07, 0.024)

        accept.onClick() ->
            accept.releaseKeyboardFocus(GetTriggerPlayer())
            dismissFor(GetTriggerPlayer())
            if listener != null
                listener.onAccept(GetTriggerPlayer())

        cancel.onClick() ->
            cancel.releaseKeyboardFocus(GetTriggerPlayer())
            dismissFor(GetTriggerPlayer())
            if listener != null
                listener.onCancel(GetTriggerPlayer())

        // Pad by the ornate border inset so the title / message / buttons clear the decorated border.
        let inset = PANEL_BORDER_INSET
        let innerWidth = width - 2. * inset
        let layout = new TableLayout(width, height, "ConfirmDialog")
        layout.padding = padding(inset, inset, inset, inset)
        layout.gap(SPACE_XS, SPACE_XS + SPACE_2XS)
        layout
        ..row()..add(h3(title)..setSize(innerWidth, 0.018))..growX()
        ..row()..add(p(message)..setSize(innerWidth, 0.040))..growX()
        ..row()..end_()
        ..add(cancel)
        ..add(accept)
        layout.applyTo(frame)
        destroy layout
        defaultFrameParent = prevParent
        return frame

    function show() returns thistype
        create().show()
        if modal != null
            modal.show()
        return this

    function hide() returns thistype
        if frame != null
            frame.hide()
        if modal != null
            modal.hide()
        return this

    /** Shows or hides the dialog (and its modal backdrop) FOR ONE PLAYER. Creates the dialog on every
        client first, then flips only that player's visibility flag - the safe shape for prompting a
        single player. Never wrap this in a localPlayer block.
        NOTE: the dialog is one shared instance, so the first click resolves it for whoever it is
        visible to. For a prompt each player answers independently, build one per owner with
        perPlayerFrames(). */
    function setVisible(player p, bool flag) returns thistype
        create().setVisible(p, flag)
        if modal != null
            modal.setVisible(p, flag)
        return this

    function show(player p) returns thistype
        return setVisible(p, true)

    function hide(player p) returns thistype
        return setVisible(p, false)

    function getFrame() returns framehandle
        return create()

public function confirmDialog(string title, string message) returns UIConfirmDialog
    return new UIConfirmDialog(title, message)

public function confirmDialog(string title, string message, real width, real height) returns UIConfirmDialog
    return new UIConfirmDialog(title, message, width, height)

public interface DialogBody
    function run()

/** A blank "dialog frame" with full map-side control of its content: a panel backdrop on the DIALOG
    layer (so it renders above ordinary UI), plus show()/hide()/placeSafe()/withModal(). Use
    confirmDialog for quick yes/no prompts; use this when you need arbitrary dialog content.

    Build content INSIDE build() so it is created under the dialog frame (no reparenting / hit-area
    misalignment). Pad your layout by at least PANEL_BORDER_INSET to clear the ornate border:

        let d = dialogFrame(0.30, 0.20)
        d.build() ->
            let layout = new TableLayout(0.30, 0.20, "MyDialog")
            layout.padding = padding(PANEL_BORDER_INSET, PANEL_BORDER_INSET, PANEL_BORDER_INSET, PANEL_BORDER_INSET)
            layout..row()..add(h3("Title"))..growX()
            layout..row()..add(p("Body")..setSize(0.27, 0.05))..growX()
            layout.applyTo(d.getFrame())
        d..withModal()..placeSafe(vec2(0.35, 0.45))..show() */
public class UIDialog
    private real width
    private real height
    private framehandle frame = null
    private UIModalBackdrop modal = null
    // See UIConfirmDialog.ownerScoped: dismissal follows how the dialog was shown.
    private var ownerScoped = false

    construct(real width, real height)
        this.width = width
        this.height = height

    /** Attaches a dark full-screen backdrop that dims the scene behind the dialog and closes it
        on any outside click. Call before show(). Default opacity: 0.8.
        The outside click closes the dialog for the CLICKING player when it was shown per player
        (show(p)), or for everyone when it was shown globally (show()). */
    function withModal() returns thistype
        return withModal(MODAL_DEFAULT_OPACITY)

    function withModal(real opacity) returns thistype
        if modal == null
            modal = new UIModalBackdrop(Layer.DIALOG, MODAL_BARRIER_LEVEL, opacity)
            modal.onClick() clicker ->
                dismissFor(clicker)
        return this

    /** Closes the dialog for `p` alone when it was shown per player, or for everyone when it was
        shown globally. */
    private function dismissFor(player p)
        if ownerScoped and p != null
            hide(p)
        else
            hide()

    /** Creates (once) the dialog backdrop on the DIALOG layer and returns it, hidden. */
    function getFrame() returns framehandle
        if frame == null
            let prev = defaultFrameParent
            defaultFrameParent = Layer.DIALOG.getFrame()

            if modal != null
                modal.create()

            frame = panel(width, height)..hide()

            if modal != null
                frame.setLevel(MODAL_CONTENT_LEVEL)

            defaultFrameParent = prev
        return frame

    /** Runs `body` with defaultFrameParent set to the dialog frame, so content built inside it (helpers,
        a TableLayout applied to getFrame()) is CREATED in place rather than reparented. Returns the frame. */
    function build(DialogBody body) returns framehandle
        let f = getFrame()
        let prev = defaultFrameParent
        defaultFrameParent = f
        body.run()
        defaultFrameParent = prev
        return f

    function show() returns thistype
        getFrame().show()
        if modal != null
            modal.show()
        return this

    function hide() returns thistype
        if frame != null
            frame.hide()
        if modal != null
            modal.hide()
        return this

    /** Creates (once) the dialog on every client. Call this at elapsed 0.00 for all players when the
        dialog is later shown per-player, so no allocation can ever happen inside a local block. */
    function create() returns framehandle
        return getFrame()

    /** Shows or hides the dialog (and its modal backdrop) FOR ONE PLAYER. Creates it on every client
        first, then flips only that player's visibility flag. Never wrap this in a localPlayer block. */
    function setVisible(player p, bool flag) returns thistype
        getFrame().setVisible(p, flag)
        if modal != null
            modal.setVisible(p, flag)
        return this

    function show(player p) returns thistype
        return setVisible(p, true)

    function hide(player p) returns thistype
        return setVisible(p, false)

    /** Returns a sized "X" button that closes this dialog (including its modal backdrop). Use this
        instead of closeButton(getFrame()) when a modal is attached, so the backdrop is dismissed
        together with the panel. Closes for the clicking player when the dialog was shown per player,
        for everyone when it was shown globally. */
    function closeButton() returns framehandle
        return closeButton(0.018)

    function closeButton(real size) returns framehandle
        let btn = textButton("X", size, size)
        btn.onClick() ->
            btn.releaseKeyboardFocus(GetTriggerPlayer())
            dismissFor(GetTriggerPlayer())
        return btn

    /** Positions the dialog's TOPLEFT, clamped into the safe area (clear of the melee HUD). */
    function placeSafe(vec2 topLeft) returns thistype
        getFrame().placeSafe(topLeft, width, height)
        return this

public function dialogFrame(real width, real height) returns UIDialog
    return new UIDialog(width, height)
